PORT=4000
CORS_ORIGIN=*
DATABASE_URL=postgres://postgres:postgres@localhost:5432/immo_agence
JWT_SECRET=change-this-secret-before-production

# PayDunya: garder les vraies cles uniquement dans .env, jamais dans Flutter.
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=your_master_key
PAYDUNYA_PUBLIC_KEY=your_test_public_key
PAYDUNYA_PRIVATE_KEY=your_test_private_key
PAYDUNYA_TOKEN=your_test_token
PAYDUNYA_STORE_NAME=ImmoAgence Senegal
PAYDUNYA_STORE_TAGLINE=Immobilier premium au Senegal
PAYDUNYA_STORE_PHONE=+221000000000
PAYDUNYA_STORE_WEBSITE_URL=http://localhost:4000
PAYDUNYA_RETURN_URL=http://localhost:4000/payments/paydunya/return
PAYDUNYA_CANCEL_URL=http://localhost:4000/payments/paydunya/cancel
PAYDUNYA_IPN_URL=http://localhost:4000/payments/paydunya/ipn
